# ---------------------------------------------------------------------------
# Redis / KV store — persists ingest events, rate-limit counters, pairing codes,
# and the parent→children pairing sets. Auth identity is NOT stored here.
# ---------------------------------------------------------------------------

# Redis connection string. Local dev: `docker run -p 6379:6379 redis:7`. Prod:
# use the connection URL from Vercel KV / Upstash (rediss://default:<token>@…).
# If unset, the app falls back to an in-memory stub (data lost on reload).
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Supabase — parent-account authentication (multi-parent, hosted)
# ---------------------------------------------------------------------------

# Public project URL for your Supabase instance. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://aqcggqeeccoqwdxdkawm.supabase.co

# Publishable (a.k.a. anon) key. Safe to expose to the browser; used by both
# the client SDK and the server-side `@supabase/ssr` cookie flow.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ytXZCdoS8FYcu3Ej9ZGryg_PPb71pDj

# ---------------------------------------------------------------------------
# Dev / demo seeder — POST /api/dev/seed (see parental-dashboard/scripts/README.md)
# ---------------------------------------------------------------------------

# Shared secret required in the `x-seed-token` header. Generate any random string
# (e.g. `openssl rand -hex 24`). Never reuse in production.
SEED_TOKEN=changeme-dev-seed-token

# Belt-and-suspenders kill-switch: in production the seeder returns 404 unless
# this is exactly `true`. Leave unset for real launches; set to `true` only when
# pre-populating a Vercel demo deploy for Fig 3 screenshots.
# ALLOW_SEED=true

# Optional: only needed if you want the seeder to accept `parent_email` and
# look up the matching Supabase user via the Admin API. If unset, callers must
# pass `parent_id` (Supabase UUID) directly. This key MUST NOT be exposed to
# the browser and is not required for normal dashboard operation.
# SUPABASE_SERVICE_ROLE_KEY=
