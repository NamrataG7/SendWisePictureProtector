<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.SafeKeyboard"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        tools:targetApi="31">

        <!-- Main launcher activity -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Settings activity -->
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:label="@string/settings" />

        <!-- Parental-link pairing activity -->
        <activity
            android:name=".ui.PairingActivity"
            android:exported="false"
            android:label="@string/pairing_title" />

        <!-- Transparent image picker proxy activity for the "attach &amp;
             protect image" IME feature. IMEs cannot call
             startActivityForResult directly, so the IME launches this
             translucent, non-exported Activity which forwards the picked
             Uri back via com.safekeyboard.media.ImageHandoff. -->
        <activity
            android:name=".ui.ImagePickerActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- IME Service - This is the core keyboard service -->
        <service
            android:name=".ime.SafeKeyboardIME"
            android:label="@string/keyboard_name"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- Overlay service for blocking popup -->
        <service
            android:name=".ui.OverlayService"
            android:exported="false" />

        <!-- FileProvider: exposes ONLY cacheDir/images/ — the short-lived
             cache file used to hand off a picked image to the host app via
             InputConnection.commitContent() or the clipboard fallback.
             Deleted immediately after use / on IME destroy. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
