<?xml version="1.0" encoding="utf-8"?>
<!--
  Modifier key background (shift, backspace, symbols, enter).
  NOTE: Standard android.inputmethodservice.KeyboardView applies a single
  keyBackground drawable to every key. Per-key differentiation requires a
  custom KeyboardView subclass, which is out of scope for this polish pass.
  This drawable is provided for future use and referenced from the shift
  key's checkable state (state_checkable) where the framework does honor it.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/key_shadow" />
                    <corners android:radius="4dp" />
                </shape>
            </item>
            <item android:bottom="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/key_background_pressed" />
                    <corners android:radius="4dp" />
                    <stroke android:width="0.5dp" android:color="@color/key_stroke" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/key_shadow" />
                    <corners android:radius="4dp" />
                </shape>
            </item>
            <item android:bottom="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/key_background_modifier" />
                    <corners android:radius="4dp" />
                    <stroke android:width="0.5dp" android:color="@color/key_stroke" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
